    given-names: Emilio
    orcid: "https://orcid.org/0009-0000-0406-5985"
    affiliation: "Forschungszentrum Jülich"
    email: emilio.taggi@gmail.com
version: 0.2.0
date-released: "2026-10-23"
doi: 10.5281/zenodo.23598681
license: GPL-3.0-or-later
repository-code: "https://github.com/Tag-E/h4lat"
url: "https://github.com/Tag-E/h4lat"
keywords:
  - lattice QCD
  - hypercubic group
  - H(4)
  - Clebsch-Gordan coefficients
  - lattice operators
  - parton distribution functions
